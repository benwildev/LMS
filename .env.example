# PostgreSQL connection string (local, Neon, Supabase, Railway, a VPS…)
DATABASE_URL="postgresql://biology_universe:change-me@localhost:5432/biology_universe"

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# The first admin account, created automatically the first time the app starts
# (only if no admin exists yet). Change the password after your first login.
ADMIN_EMAIL="admin@biologyuniverse.test"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# Set to "false" only if you run production over plain HTTP (not recommended)
COOKIE_SECURE="true"

# Optional tuning for slow or far-away databases
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=15000

# Course materials (PDFs, images…) are stored here. On a server, point it at a folder that is backed up.
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=25
